  m_Script: {fileID: 11500000, guid: 41ba8d8aed8a43d5cb3f592bdb0c39d5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: LastEvidence.Runtime::LastEvidence.PasswordPuzzle
  puzzleId: computer
  displayName: L'ordinateur de Victor
  hints:
  - "La note trouv\xE9e dans le coffre-fort d\xE9crit le mot de passe."
  - "Le \xAB fid\xE8le compagnon \xBB de Victor figure sur une photo de son bureau : retournez-la."
  - "Le chien s'appelle Rex et la photo date de l'\xE9t\xE9 2009 : REX2009."
  solvedMessage: "Ordinateur d\xE9verrouill\xE9 : la porte des archives s'ouvre."
  onSolved:
    m_PersistentCalls:
      m_Calls: []
  password: REX2009
  userName: Victor Lemaire
  emails:
  - from: "Victor Lemaire \u2192 Me Gagnon"
    subject: Plainte et dissolution
    body: "Victor \xE0 Me Gagnon, 13 octobre : \xAB J'ai la preuve que Marc d\xE9tourne des fonds depuis un an et demi. Je le confronte demain soir et je porte plainte lundi. Pr\xE9parez la dissolution de l'association. \xBB"
    evidence: {fileID: 11400000, guid: f52e86d683e39dde3b878cf6240a3ef6, type: 2}
  - from: Julien Roy
    subject: Mes affaires personnelles
    body: "Julien Roy \xE0 Victor, 10 octobre : \xAB Je passerai r\xE9cup\xE9rer mes affaires personnelles aux archives. Mon badge fonctionne encore. Je regrette ma lettre de septembre, \xE9crite sous le coup de la col\xE8re. \xBB"
    evidence: {fileID: 11400000, guid: f9b73a736f31dc2b5b9ff632598cecfe, type: 2}
  - from: Sophie Tremblay
    subject: Gala de ce soir
    body: "\xAB Je serai au gala avec Marc ce soir. Je prendrai des photos pour la revue interne. Bon courage pour votre rendez-vous de 21 h. - Sophie \xBB"
    evidence: {fileID: 0}
  - from: "Syst\xE8me de s\xE9curit\xE9"
    subject: Porte des archives
    body: "Commande \xE0 distance re\xE7ue : la porte de la salle des archives est d\xE9verrouill\xE9e."
    evidence: {fileID: 0}
