  m_Script: {fileID: 11500000, guid: d3848c50d2d5b9ac59c27a5413636af0, type: 3}
  m_Name: 
  m_EditorClassIdentifier: LastEvidence.Runtime::LastEvidence.TimelinePuzzle
  puzzleId: timeline
  displayName: "Syst\xE8me de s\xE9curit\xE9 - s\xE9quence du 14 octobre"
  hints:
  - "L'onglet Chronologie du journal classe les \xE9v\xE9nements dat\xE9s par vos preuves."
  - "Le registre des entr\xE9es, le rapport du gardien et l'enregistrement t\xE9l\xE9phonique donnent des heures pr\xE9cises."
  - "Claire (19 h 02), Julien (20 h 40), porte arri\xE8re (21 h 10), fusible retir\xE9 (21 h 12), Victor re\xE7oit Marc (21 h 31), corps d\xE9couvert (23 h)."
  solvedMessage: "S\xE9quence valid\xE9e. Un m\xE9canisme se d\xE9clenche dans le mur nord !"
  onSolved:
    m_PersistentCalls:
      m_Calls: []
  correctOrder:
  - id: claire
    text: "Claire rend visite \xE0 son oncle et se dispute avec lui"
  - id: julien
    text: "Julien Roy entre avec son ancien badge pour r\xE9cup\xE9rer ses affaires"
  - id: backdoor
    text: "Quelqu'un entre par la porte arri\xE8re avec le code de maintenance"
  - id: fuse
    text: "Un fusible est retir\xE9 : les cam\xE9ras s'\xE9teignent"
  - id: drink
    text: "Victor re\xE7oit Marc dans son bureau et lui sert un verre"
  - id: body
    text: "Le gardien d\xE9couvre le corps de Victor"
  initialOrder: 040000000200000005000000000000000300000001000000i
