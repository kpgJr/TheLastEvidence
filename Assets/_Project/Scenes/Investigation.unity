  m_EditorClassIdentifier: LastEvidence.Runtime::LastEvidence.ObjectiveManager
  objectives:
  - id: o1
    text: "Lire le message anonyme laiss\xE9 dans le hall"
    completionFlag: evidence.ev_message
  - id: o2
    text: "Trouver la cl\xE9 du bureau de la victime"
    completionFlag: item.key_office
  - id: o3
    text: Entrer dans le bureau de Victor Lemaire
    completionFlag: door.door_office
  - id: o4
    text: "Ouvrir le coffre-fort du bureau (code \xE0 4 chiffres)"
    completionFlag: puzzle.safe
  - id: o5
    text: "D\xE9verrouiller l'ordinateur de Victor"
    completionFlag: puzzle.computer
  - id: o6
    text: Fouiller la salle des archives
    completionFlag: item.key_surveillance
  - id: o7
    text: Entrer dans la salle de surveillance
    completionFlag: door.door_surveillance
  - id: o8
    text: "R\xE9tablir le courant (bo\xEEte \xE0 fusibles)"
    completionFlag: puzzle.power
  - id: o9
    text: Consulter les preuves et reconstituer la chronologie
    completionFlag: puzzle.timeline
  - id: o10
    text: "D\xE9signer le coupable depuis la pi\xE8ce secr\xE8te"
    completionFlag: case.closed
  - id: o11
    text: "Quitter le b\xE2timent par la porte principale"
    completionFlag: game.exit
